# AgentGuard Configuration
# Example variables. Do NOT put real secrets in this file.

# The SQLite database path (can be absolute or relative)
AGENTGUARD_DB=agentguard.db

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
AGENTGUARD_LOG_LEVEL=INFO

# Application URL (for MCP Gateway and SDK default)
AGENTGUARD_URL=http://localhost:8000

# Default Agent ID for SDK/Decorators (if not passed explicitly)
AGENTGUARD_AGENT_ID=research-agent

# Default User ID (Principal)
AGENTGUARD_USER_ID=user-001
